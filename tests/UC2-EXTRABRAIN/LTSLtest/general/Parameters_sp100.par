K                15
K_mode           linear
mean_nbin        88
deriv1st_nbin    39
binmode          rbf
infilename_md    features.dat
timeseries_file  mgdata.pkl     #ignored by Mains.multi(); kept so Mains.general() could still run against this file if desired
taumin           1.0
taumax           1476.0
offs             1
trnpat           2000           #ignored by Mains.multi() (derived from train_files)
vanpat           1000           #ignored by Mains.multi() (derived from val_files)
tenpat           1000           #ignored by Mains.multi() (derived from test_files)
ngenstep         0              #forced to 0 by Mains.multi() (autoregression across stock boundaries is ill-defined)
outagain_gen     1.0
fs               1.0
#Multi-dataset phases over the full sp100_daily_prices.csv (98 tickers).
#Late-IPO tickers (DOW, META, GOOGL, KHC, PYPL, ABBV, GM, CHTR, AVGO, V, PM, MA, CRM, NFLX, ACN, MDLZ, MET)
#are kept in the training set; phase_to_concat_features trims their leading NaNs per column.
#78 train / 10 val / 10 test, sector-spread val and test (test mirrors Parameters_sp81.par for comparability).
train_files      sp100_daily_prices:AAPL,ABBV,ABT,ACN,ADBE,AIG,ALL,AMT,AVGO,AXP,BAC,BK,BKNG,BLK,BMY,C,CHTR,CL,COF,COP,COST,CRM,CSCO,CVS,DHR,DIS,DOW,EMR,EXC,FDX,GD,GE,GILD,GM,GOOGL,HD,HON,INTC,KHC,LIN,LLY,LMT,LOW,MA,MDLZ,MDT,MET,META,MMM,MO,MRK,MS,MSFT,NEE,NFLX,NKE,ORCL,PEP,PFE,PM,PYPL,QCOM,RTX,SBUX,SLB,SO,SPG,TGT,TMO,TXN,UNH,UNP,UPS,USB,V,VZ,WBA,WFC
val_files        sp100_daily_prices:GS,IBM,MCD,AMGN,CMCSA,DUK,CAT,DD,F,AMZN
test_files       sp100_daily_prices:NVDA,JPM,JNJ,XOM,WMT,BA,KO,CVX,T,PG
