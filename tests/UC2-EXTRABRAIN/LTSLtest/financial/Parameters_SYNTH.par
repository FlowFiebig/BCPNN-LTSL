K                3
K_mode           logarithmic
feature_set      return_variance
return_nbin      50             #decode-target channel (log return; displayed as ratio via exp); C++ alias of mean_nbin
variance_nbin    50               #secondary channel (trailing log-return variance); C++ alias of deriv1st_nbin
variance_window  3                #trailing log-return variance window; also feature/calendar align
binmode          rbf-quantile  # rbf = linear centres on 0.25% winsor range; rbf-quantile = empirical-quantile centres + adaptive sigma
infilename_md    features.dat
timeseries_file  SYNTH.csv  #wide CSV in datasets/; generated by nb-SYNTH.ipynb (calibrated Gaussian log returns)
taumin           1.0
taumax           20.0
offs             1
warmup_pat       0               #forward-only steps at ticker-to-ticker transitions (k>0)
trnpat           3900             #per-ticker per-block training rows
vanpat           100              #per-ticker per-block validation rows
tenpat           990             #per-ticker per-block test rows -> 989 scored test steps (~10 expected violations at 1%)
ngenstep         0               #forced to 0 by Mains.multislice()
outagain_gen     1.0
fs               1.0
bdebias          1             #debias fix by Fable5
# SYNTH.csv has 5001 price rows (initial price 1.0 + 5000 calibrated Gaussian
# log-return steps); with variance_window=3 that is 4999 feature rows, so
# block_step = 3900+100+990 = 4990 fits in a single block.
tickers        SYNTH
schedule_file    schedule.dat  #written by Mains.multislice(); one row per block
